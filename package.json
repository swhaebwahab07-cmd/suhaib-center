{
  "name": "suhaib-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "dev:clean": "if exist .next rmdir /s /q .next && next dev --turbo",
    "dev:center": "next dev --turbo -H 0.0.0.0 -p 5000",
    "dev:ip": "next dev --turbo -H 192.168.1.2 -p 3000",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
